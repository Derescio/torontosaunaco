          "86.25\" × 84.75\" × 86.25\" (219 × 215 × 219 cm)"
        ],
        [
          "Interior (W × D)",
          "80.25\" × 83.25\""
        ],
        [
          "Interior volume",
          "315 cu ft"
        ],
        [
          "Seating",
          "3–4 people, two-tier benches"
