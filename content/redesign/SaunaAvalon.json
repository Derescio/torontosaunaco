      "about": {
        "title": "A proper log sauna",
        "lede": "Solid cedar log walls, a big window and three bench levels make the Avalon feel like a cottage sauna.",
        "items": [
          [
            "Solid cedar log walls",
            "2¾\" double-groove eastern white cedar logs hold heat and give that classic timber look."
          ],
          [
            "Three tiers of heat",
            "Benches at 16\", 32\" and 48\", each 79\" long. Sit high for heat, low to cool down."
          ],
          [
            "A 75\" picture window",
            "A 75\" × 50¼\" window looks out from the bench side."
          ],
          [
            "Wood or electric",
            "Big enough for a wood-burning stove as well as electric, under a sloped metal roof that extends past the walls."
          ]
        ]
      },
