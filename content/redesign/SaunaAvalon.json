      "blocks": [
        {
          "type": "text",
          "html": "<strong>About this sauna</strong>",
          "text": "About this sauna"
        },
        {
          "type": "heading",
          "level": 2,
          "html": "A proper log sauna",
          "text": "A proper log sauna"
        },
        {
          "type": "paragraph",
          "html": "Solid cedar log walls, a big window and three bench levels make the Avalon feel like a cottage sauna.",
          "text": "Solid cedar log walls, a big window and three bench levels make the Avalon feel like a cottage sauna."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Solid cedar log walls",
          "text": "Solid cedar log walls"
        },
        {
          "type": "paragraph",
          "html": "2¾\" double-groove eastern white cedar logs hold heat and give that classic timber look.",
          "text": "2¾\" double-groove eastern white cedar logs hold heat and give that classic timber look."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Three tiers of heat",
          "text": "Three tiers of heat"
        },
        {
          "type": "paragraph",
          "html": "Benches at 16\", 32\" and 48\", each 79\" long. Sit high for heat, low to cool down.",
          "text": "Benches at 16\", 32\" and 48\", each 79\" long. Sit high for heat, low to cool down."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "A 75\" picture window",
          "text": "A 75\" picture window"
        },
        {
          "type": "paragraph",
          "html": "A 75\" × 50¼\" window looks out from the bench side.",
          "text": "A 75\" × 50¼\" window looks out from the bench side."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Wood or electric",
          "text": "Wood or electric"
