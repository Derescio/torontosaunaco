    {
      "name": "Section 1",
      "blocks": [
        {
          "type": "text",
          "html": "About this sauna",
          "text": "About this sauna"
        },
        {
          "type": "heading",
          "level": 2,
          "html": "A glass-front sauna for inside your home",
          "text": "A glass-front sauna for inside your home"
        },
        {
          "type": "paragraph",
          "html": "The 572 gives you a longer bench and a full wall of glass, for a sauna that feels open even indoors.",
          "text": "The 572 gives you a longer bench and a full wall of glass, for a sauna that feels open even indoors."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Built in panels",
          "text": "Built in panels"
        },
        {
          "type": "paragraph",
          "html": "Walls and roof arrive assembled, with prebuilt cedar benches and a duckboard floor, so it goes together in a few hours in a basement, spare room or gym.",
          "text": "Walls and roof arrive assembled, with prebuilt cedar benches and a duckboard floor, so it goes together in a few hours in a basement, spare room or gym."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Room for three",
          "text": "Room for three"
        },
        {
          "type": "paragraph",
          "html": "Seven-foot benches on two tiers seat three adults, or let one person lie down.",
          "text": "Seven-foot benches on two tiers seat three adults, or let one person lie down."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Glass that stays clear",
          "text": "Glass that stays clear"
        },
        {
          "type": "paragraph",
          "html": "The front windows are 1\" double-pane tempered glass that won’t fog, with a 10 mm bronze glass door. Add semi-privacy cedar panels if you prefer.",
          "text": "The front windows are 1\" double-pane tempered glass that won’t fog, with a 10 mm bronze glass door. Add semi-privacy cedar panels if you prefer."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Clear or knotty red cedar",
          "text": "Clear or knotty red cedar"
        },
        {
          "type": "paragraph",
          "html": "Choose knotty western red cedar for a rustic look, or clear cedar for a smooth, knot-free finish.",
          "text": "Choose knotty western red cedar for a rustic look, or clear cedar for a smooth, knot-free finish."
        }
