    {
      "name": "Section 1",
      "blocks": [
        {
          "type": "text",
          "html": "<strong>About this sauna</strong>",
          "text": "About this sauna"
        },
        {
          "type": "heading",
          "level": 2,
          "html": "Room for the whole family",
          "text": "Room for the whole family"
        },
        {
          "type": "paragraph",
          "html": "The 572 stretches the Pure Cube to a full 76½\" of bench, so three or four people can sit back without bumping elbows.",
          "text": "The 572 stretches the Pure Cube to a full 76½\" of bench, so three or four people can sit back without bumping elbows."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Long, two-tier benches",
          "text": "Long, two-tier benches"
        },
        {
          "type": "paragraph",
          "html": "A 34\" upper bench for the most heat and a 17\" lower bench for an easier session, both a full 76½\" long in clear red cedar.",
          "text": "A 34\" upper bench for the most heat and a 17\" lower bench for an easier session, both a full 76½\" long in clear red cedar."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "A wall of glass",
          "text": "A wall of glass"
        },
        {
          "type": "paragraph",
          "html": "Three 25¾\" panels across the front, with the glass door in the middle. Swap to mirrored glass or slatted semi-privacy panels if neighbours are close.",
          "text": "Three 25¾\" panels across the front, with the glass door in the middle. Swap to mirrored glass or slatted semi-privacy panels if neighbours are close."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Canadian red cedar",
          "text": "Canadian red cedar"
        },
        {
          "type": "paragraph",
          "html": "Western red cedar inside and out handles heat and moisture, resists rot and stays comfortable to touch. Knotty is rustic; clear is smooth and knot-free.",
          "text": "Western red cedar inside and out handles heat and moisture, resists rot and stays comfortable to touch. Knotty is rustic; clear is smooth and knot-free."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Built for four seasons",
          "text": "Built for four seasons"
        },
        {
          "type": "paragraph",
          "html": "An EPDM roof, tempered glass and raised base skids keep it dry and working through Ontario snow, freeze and thaw.",
          "text": "An EPDM roof, tempered glass and raised base skids keep it dry and working through Ontario snow, freeze and thaw."
        }
