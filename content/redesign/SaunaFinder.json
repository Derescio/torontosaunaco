  "sections": [
    {
      "name": "Section 1",
      "blocks": [
        {
          "type": "breadcrumb",
          "items": [
            {
              "text": "Home",
              "href": "/"
            },
            {
              "text": "Sauna Finder"
            }
          ]
        }
      ]
    },
    {
      "name": "Sauna finder",
      "blocks": [
        {
          "type": "text",
          "html": "<strong>Sauna finder</strong>",
          "text": "Sauna finder"
        },
        {
          "type": "heading",
          "level": 1,
          "html": "Find a sauna that fits your <em><strong>space.</strong></em>",
          "text": "Find a sauna that fits your space."
        },
        {
          "type": "paragraph",
          "html": "Tell us how much room you have and we’ll show every sauna that fits, plus the ones that come close.",
          "text": "Tell us how much room you have and we’ll show every sauna that fits, plus the ones that come close."
        },
        {
          "type": "repeat",
          "list": "{{fdModes}}",
          "as": "m",
          "blocks": [
            {
              "type": "link",
              "html": "{{m.label}}",
              "text": "{{m.label}}",
              "href": null,
              "variant": "button"
            }
          ]
        },
        {
          "type": "field",
          "label": "Width of your space (feet)",
          "id": null,
          "control": "input",
          "inputType": "number",
          "placeholder": "e.g. 8"
        },
        {
          "type": "field",
          "label": "Depth of your space (feet)",
          "id": null,
          "control": "input",
          "inputType": "number",
          "placeholder": "e.g. 10"
        },
        {
          "type": "if",
          "value": "{{fdIndoor}}",
          "blocks": [
            {
              "type": "field",
              "label": "Ceiling height (feet, optional)",
              "id": null,
              "control": "input",
              "inputType": "number",
              "placeholder": "e.g. 8"
            }
          ]
        },
        {
          "type": "text",
          "html": "<strong>How many people? (optional)</strong>",
          "text": "How many people? (optional)"
        },
        {
          "type": "repeat",
          "list": "{{fdPeople}}",
          "as": "p",
          "blocks": [
            {
              "type": "link",
              "html": "{{p.label}}",
              "text": "{{p.label}}",
              "href": null,
              "variant": "button"
            }
          ]
        },
        {
          "type": "if",
          "value": "{{fdIdle}}",
          "blocks": [
            {
              "type": "paragraph",
              "html": "Enter your width and depth to see what fits. Not sure? Measure the clear floor area where the sauna will sit.",
              "text": "Enter your width and depth to see what fits. Not sure? Measure the clear floor area where the sauna will sit."
            }
          ]
        },
        {
          "type": "if",
          "value": "{{fdReady}}",
          "blocks": [
            {
              "type": "paragraph",
              "html": "{{fdSummary}}",
              "text": "{{fdSummary}}"
            },
            {
              "type": "repeat",
              "list": "{{fdResults}}",
              "as": "r",
              "blocks": [
                {
                  "type": "card",
                  "href": "{{r.href}}",
                  "blocks": [
                    {
                      "type": "image",
                      "src": "{{r.img}}",
                      "alt": "{{r.alt}}"
                    },
                    {
                      "type": "text",
                      "html": "{{r.badge}}",
                      "text": "{{r.badge}}"
                    },
                    {
                      "type": "text",
                      "html": "<strong>{{r.n}}</strong>",
                      "text": "{{r.n}}"
                    },
                    {
                      "type": "text",
                      "html": "{{r.detail}}",
                      "text": "{{r.detail}}"
                    },
                    {
                      "type": "text",
                      "html": "{{r.seats}}",
                      "text": "{{r.seats}}"
                    },
                    {
                      "type": "text",
                      "html": "<strong>{{r.price}}</strong>",
                      "text": "{{r.price}}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "if",
              "value": "{{fdNone}}",
              "blocks": [
                {
                  "type": "text",
                  "html": "<strong>Nothing off the shelf fits that space.</strong>",
                  "text": "Nothing off the shelf fits that space."
                },
                {
                  "type": "text",
                  "html": "That’s exactly what our custom builds are for. Tell us your measurements and we’ll design around them.",
                  "text": "That’s exactly what our custom builds are for. Tell us your measurements and we’ll design around them."
                }
              ]
            }
          ]
        },
        {
          "type": "link",
          "html": "Get a quote for my space",
          "text": "Get a quote for my space",
          "href": "{{fdQuote}}",
          "variant": "button"
        },
        {
          "type": "link",
          "html": "{{fdCustomLabel}}",
          "text": "{{fdCustomLabel}}",
          "href": "{{fdCustomHref}}",
          "variant": "button"
        },
        {
          "type": "text",
          "html": "“Close fit” saunas are within about a foot of your space. Many still work, and we confirm the exact fit with your quote.",
          "text": "“Close fit” saunas are within about a foot of your space. Many still work, and we confirm the exact fit with your quote."
        }
      ]
    }
  ],
  "warnings": []
}
