      "about": {
        "title": "Sauna as furniture",
        "lede": "The Studio reads less like equipment and more like architecture, with room to sit up, lie down or share.",
        "items": [
          [
            "Thermo Grandis wood",
            "A sustainably sourced hardwood, thermally modified in Ontario so it stays stable and resists moisture, with a rich, even colour."
          ],
          [
            "Space for four",
            "Two wide tiers, 20\" upper and 15\" lower, seat up to four or let you stretch out."
          ],
          [
            "A full glass front",
            "10 mm tempered glass across the front, including the door, makes it a feature of the room rather than a box in the corner."
          ],
          [
            "Built properly",
            "Triple-layer walls with a vapour barrier and wiring gap, and a fully framed floor, so it heats efficiently and sits solid on any surface."
          ]
        ]
      }
    }
