    {
      "name": "Section 1",
      "blocks": [
        {
          "type": "text",
          "html": "About this sauna",
          "text": "About this sauna"
        },
        {
          "type": "heading",
          "level": 2,
          "html": "Small footprint, full sauna experience",
          "text": "Small footprint, full sauna experience"
        },
        {
          "type": "paragraph",
          "html": "The 552 proves you don’t need a big yard for a real Finnish-style sauna. Here’s what makes it work.",
          "text": "The 552 proves you don’t need a big yard for a real Finnish-style sauna. Here’s what makes it work."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Canadian red cedar, inside and out",
          "text": "Canadian red cedar, inside and out"
        },
        {
          "type": "paragraph",
          "html": "Grade-A western red cedar resists rot and moisture, stays cool to the touch and smells incredible when it heats up. Choose knotty for a rustic look or clear for a smooth, knot-free finish.",
          "text": "Grade-A western red cedar resists rot and moisture, stays cool to the touch and smells incredible when it heats up. Choose knotty for a rustic look or clear for a smooth, knot-free finish."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "A real view from the bench",
          "text": "A real view from the bench"
        },
        {
          "type": "paragraph",
          "html": "A tall bronze glass panel and full glass door fill the room with light. Prefer privacy? Switch to mirrored glass or slatted semi-privacy panels.",
          "text": "A tall bronze glass panel and full glass door fill the room with light. Prefer privacy? Switch to mirrored glass or slatted semi-privacy panels."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Built for Ontario winters",
          "text": "Built for Ontario winters"
        },
        {
          "type": "paragraph",
          "html": "A weather-resistant EPDM roof, double-sealed glass and raised base skids keep it dry and heating well through freeze, thaw and snow.",
          "text": "A weather-resistant EPDM roof, double-sealed glass and raised base skids keep it dry and heating well through freeze, thaw and snow."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Ready in about a day",
          "text": "Ready in about a day"
        },
        {
          "type": "paragraph",
          "html": "It ships as precut panels. Our team delivers and installs it in about 5 to 6 hours, typically 2 to 4 weeks after you order.",
          "text": "It ships as precut panels. Our team delivers and installs it in about 5 to 6 hours, typically 2 to 4 weeks after you order."
        }
