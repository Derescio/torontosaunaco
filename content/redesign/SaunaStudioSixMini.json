      "name": "Section 1",
      "blocks": [
        {
          "type": "text",
          "html": "<strong>About this sauna</strong>",
          "text": "About this sauna"
        },
        {
          "type": "heading",
          "level": 2,
          "html": "Built like a house, heats like a sauna",
          "text": "Built like a house, heats like a sauna"
        },
        {
          "type": "paragraph",
          "html": "The Studio Six Mini packs a four-season sauna into a footprint about 6' × 5', ideal for a small yard, deck or rooftop.",
          "text": "The Studio Six Mini packs a four-season sauna into a footprint about 6' × 5', ideal for a small yard, deck or rooftop."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "R24 insulated walls",
          "text": "R24 insulated walls"
        },
        {
          "type": "paragraph",
          "html": "4½\" structural insulated panels with a foil barrier and an air gap behind the cedar keep the heat in, so it warms up faster and holds temperature in January.",
          "text": "4½\" structural insulated panels with a foil barrier and an air gap behind the cedar keep the heat in, so it warms up faster and holds temperature in January."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Glass door and panel",
          "text": "Glass door and panel"
        },
        {
          "type": "paragraph",
          "html": "A 30\" glass door and 22\" panel in bronze-tinted double-pane glass let the light in and keep the heat where it belongs.",
          "text": "A 30\" glass door and 22\" panel in bronze-tinted double-pane glass let the light in and keep the heat where it belongs."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Choose your feature wall",
          "text": "Choose your feature wall"
        },
        {
          "type": "paragraph",
          "html": "Keep the classic all-cedar look, or add a rhombus or hexagon cedar feature wall for a bolder interior.",
          "text": "Keep the classic all-cedar look, or add a rhombus or hexagon cedar feature wall for a bolder interior."
        },
        {
          "type": "heading",
          "level": 3,
          "html": "Metal siding, three colours",
          "text": "Metal siding, three colours"
